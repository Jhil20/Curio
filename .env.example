# ==============================================================================
# Curio - Environment Configuration Template
# Copy this file to '.env' for local development.
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME="Curio"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# --- Server Binding ---
HOST="0.0.0.0"
PORT=8000

# --- Security & CORS ---
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# --- PostgreSQL Database ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="curio_user"
POSTGRES_PASSWORD="curio_password"
POSTGRES_DB="curio_db"
DATABASE_URL="postgresql+asyncpg://curio_user:curio_password@localhost:5432/curio_db"

# --- External Integrations (Deferred to Subsequent Stages) ---
# Stage 2: GitHub Personal Access Token
GITHUB_TOKEN=""

# Stage 6: OpenAI API Key & Model
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
